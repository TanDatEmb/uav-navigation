Panels:
  - Class: rviz_common/Displays
    Name: Displays

  - Class: rviz_common/Selection
    Name: Selection

  - Class: rviz_common/Tool Properties
    Name: Tool Properties

Visualization Manager:
  Class: ""

  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true

    # Current FAST-LIO output boundary consumed by planner backend ROG-Map.
    - Alpha: 0.8
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: FlatColor
      Color: 255; 190; 40
      Decay Time: 0
      Enabled: true
      Name: FAST-LIO / Registered points
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.10
      Style: Points
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lio/registered_points
      Use Fixed Frame: true

    # Propagated odometry is the active navigation/PX4 state stream.
    - Angle Tolerance: 0.01
      Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 1000
      Name: Navigation / Propagated odometry
      Position Tolerance: 0.01
      Shape:
        Axes Length: 0.5
        Axes Radius: 0.05
        Color: 40; 140; 255
        Head Length: 0.3
        Head Radius: 0.1
        Shaft Length: 1
        Shaft Radius: 0.05
        Value: Axes
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lio/odometry_propagated

    # Corrected estimator output is retained as an optional cross-check.
    - Angle Tolerance: 0.01
      Class: rviz_default_plugins/Odometry
      Enabled: false
      Keep: 1000
      Name: FAST-LIO / Corrected odometry
      Position Tolerance: 0.01
      Shape:
        Axes Length: 0.35
        Axes Radius: 0.04
        Color: 255; 80; 40
        Head Length: 0.25
        Head Radius: 0.08
        Shaft Length: 0.7
        Shaft Radius: 0.04
        Value: Axes
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lio/odometry_corrected

  Enabled: true

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: lio_odom
    Frame Rate: 30

  Name: root

  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select

  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 20
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Focal Shape Fixed Size: true
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 1.0
      Target Frame: <Fixed Frame>
      Yaw: 0.0

Window Geometry:
  Displays:
    collapsed: false
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: true
  QMainWindow State: 
  Width: 1600
  X: 0
  Y: 0
