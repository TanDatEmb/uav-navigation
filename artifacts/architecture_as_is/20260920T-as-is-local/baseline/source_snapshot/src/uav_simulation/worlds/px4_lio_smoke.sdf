<?xml version="1.0" encoding="UTF-8"?>
<!-- Minimal asymmetric world for PX4 + LIO startup and alignment tests. -->
<sdf version="1.9">
  <world name="px4_lio_smoke">
    <physics type="ode">
      <!-- Keep deterministic headroom for the headless GPU LiDAR renderer. -->
      <max_step_size>0.004</max_step_size><real_time_factor>0.8</real_time_factor>
      <real_time_update_rate>200</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene><grid>true</grid><ambient>0.4 0.4 0.4 1</ambient><background>0.72 0.78 0.85 1</background><shadows>true</shadows></scene>

    <model name="ground_plane"><static>true</static><link name="link">
      <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry></collision>
      <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
        <material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual>
    </link></model>

    <model name="smoke_wall_east"><static>true</static><pose>7 1 2.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.25 18 5</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.25 18 5</size></box></geometry>
        <material><ambient>0.60 0.25 0.20 1</ambient><diffuse>0.75 0.30 0.22 1</diffuse></material></visual>
    </link></model>

    <model name="smoke_wall_north"><static>true</static><pose>-1 9 2.0 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>12 0.25 4</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>12 0.25 4</size></box></geometry>
        <material><ambient>0.20 0.35 0.65 1</ambient><diffuse>0.25 0.45 0.80 1</diffuse></material></visual>
    </link></model>

    <model name="smoke_pillar_west"><static>true</static><pose>-4.5 2.5 2.5 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><cylinder><radius>0.55</radius><length>5</length></cylinder></geometry></collision>
      <visual name="visual"><geometry><cylinder><radius>0.55</radius><length>5</length></cylinder></geometry>
        <material><ambient>0.25 0.60 0.30 1</ambient><diffuse>0.30 0.75 0.35 1</diffuse></material></visual>
    </link></model>

    <model name="smoke_box_south"><static>true</static><pose>2.5 -5.0 1.0 0 0 0.35</pose><link name="link">
      <collision name="collision"><geometry><box><size>2.4 1.1 2.0</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>2.4 1.1 2.0</size></box></geometry>
        <material><ambient>0.75 0.60 0.15 1</ambient><diffuse>0.90 0.72 0.18 1</diffuse></material></visual>
    </link></model>

    <light name="sunUTC" type="directional"><pose>0 0 500 0 0 0</pose><cast_shadows>true</cast_shadows><intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction><diffuse>0.904 0.904 0.904 1</diffuse><specular>0.271 0.271 0.271 1</specular>
      <attenuation><range>2000</range><linear>0</linear><constant>1</constant><quadratic>0</quadratic></attenuation>
    </light>
    <spherical_coordinates><surface_model>EARTH_WGS84</surface_model><world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>10.8231</latitude_deg><longitude_deg>106.6297</longitude_deg><elevation>10</elevation>
    </spherical_coordinates>

    <!-- Spawn the vehicle in the world; PX4 later attaches by exact model name. -->
    <include>
      <uri>model://x500_mid360</uri>
      <name>x500_mid360</name>
      <pose>0 0 0.2 0 0 0</pose>
    </include>
  </world>
</sdf>
