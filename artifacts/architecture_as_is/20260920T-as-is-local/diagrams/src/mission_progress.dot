digraph G {
 graph [rankdir=TB, bgcolor="white", pad="0.2", nodesep="0.35", ranksep="0.65", fontname="DejaVu Sans"];
 node [fontname="DejaVu Sans",fontsize=10,margin="0.12,0.08"];
 edge [fontname="DejaVu Sans",fontsize=9,arrowsize=0.75];
T_ACTIVATE [shape=box,style="rounded,filled",fillcolor="#fff4d6",label="T_ACTIVATE: PX4 external mode activation followed by the immediate mission\ntimer update\nGuard: MissionController::update returns no goal while !airborne;\nairborne is isArmed() && local position z > 0.5 m. If armed/above\nthreshold on immediate update, it enters ExecutingWaypoint and\nemits PublishGoal. A separate source comment claims first goal is\npublished from onActivate; code plus unit test qualify that\nstatement.\nWrites: F_MODE_COMMAND, F_WAYPOINT, F_FRAME_ALIGNMENT,\nF_HANDOVER_MODE, F_HOLD_EXECUTOR\nEffect: publish NavigationGoal; stationary setpoint while bounded initial\nPVA acquisition; no evidence of PX4 applied command"];
T_ACTIVATE [URL="../../tables/transitions.html#T_ACTIVATE",tooltip="T_ACTIVATE: NavigationMode::onActivate -> MissionController::activate -> updateMission -> handleMissionEvent"];
T_ADMIT_COMMAND [shape=box,style="rounded,filled",fillcolor="#fff4d6",label="T_ADMIT_COMMAND: NavigationCommand callback\nGuard: contract, valid_until, frame, localization epoch,\nmission/wp/request or exact retained predecessor/suffix identity,\nworld non-regression, sample monotonicity, state/health freshness,\ncommand role/phase and stop proximity checks\nWrites: F_MODE_COMMAND, F_TRAJECTORY_READY, F_TERMINAL_HOLD,\nF_SUFFIX_HANDOFF, F_PLANNER_RECOVERY_MODE\nEffect: local acceptance then timer/tick may advance mission; no direct\nguarantee PX4 used the command"];
T_ADMIT_COMMAND [URL="../../tables/transitions.html#T_ADMIT_COMMAND",tooltip="T_ADMIT_COMMAND: NavigationMode::onNavigationCommand"];
T_PASS_PROGRESS [shape=box,style="rounded,filled",fillcolor="#fff4d6",label="T_PASS_PROGRESS: measured pass-through crossing or certified stopped-suffix\nacceptance\nGuard: trajectory ready/current witness and measured current segment\ncrossing inside acceptance radius with fresh sample gap; suffix\nstop additionally low measured speed/near certified command; STOP\ncoincident predecessor has separate terminal-readiness path\nWrites: F_WAYPOINT, F_SUFFIX_HANDOFF, F_PLANNER_RECOVERY_MODE,\nF_DESIRED_GOAL, F_ACTIVE_GOAL_EPOCH, F_PENDING_GOAL\nEffect: new desired request published; executing predecessor can remain\nauthoritative until candidate timeline swap; mission progress and\nplanner progress are asynchronous"];
T_PASS_PROGRESS [URL="../../tables/transitions.html#T_PASS_PROGRESS",tooltip="T_PASS_PROGRESS: updateMission -> MissionController::update -> handleMissionEvent(PublishGoal) -> runtime onGoal"];
T_STOP_COMPLETE [shape=box,style="rounded,filled",fillcolor="#fff4d6",label="T_STOP_COMPLETE: measured settle/confirmation/dwell or bounded safety timeout\nGuard: measured position inside acceptance radius; measured velocity <=\nconfigured acceptance speed; continuous confirmation window; hold\ndwell; pass-through safety path uses certified stop and 0.5 s\nconfirmation or 5 s safety timeout\nWrites: F_WAYPOINT, F_TERMINAL_HOLD, F_HANDOVER_MODE, F_HOLD_EXECUTOR\nEffect: measured settle, waypoint acceptance, mission Complete and Hold\nrequest are distinct events; Complete publishes Bool/status and\ncalls completed(Success); RequestPositionControl invokes Hold\ncallback"];
T_STOP_COMPLETE [URL="../../tables/transitions.html#T_STOP_COMPLETE",tooltip="T_STOP_COMPLETE: MissionController::update and NavigationMode::handleMissionEvent"];
T_ACTIVATE -> T_ADMIT_COMMAND [style=invis,weight=10];
T_ADMIT_COMMAND -> T_PASS_PROGRESS [style=invis,weight=10];
T_PASS_PROGRESS -> T_STOP_COMPLETE [style=invis,weight=10];
T_ACTIVATE -> T_ADMIT_COMMAND [style=dashed,color="#555555",label="goal then command, async ROS delivery"];
T_ADMIT_COMMAND -> T_PASS_PROGRESS [style=dashed,color="#555555",label="current accepted witness"];
T_PASS_PROGRESS -> T_STOP_COMPLETE [style=dashed,color="#555555",label="next STOP or terminal branch"];
legend [shape=note,style="rounded,filled",fillcolor="#f5f5f5",label="Each box is one guarded transition. Dashed labeled edges show supported paths; invisible edges only arrange the page. Independent callbacks may interleave."];
}
