digraph G { rankdir=LR; node [shape=box,style=rounded]; world [label="world source t_w\nlatest snapshot"]; cert [label="active certificate\nidentity + expiry"]; admit [label="candidate admission"]; sample [label="Core sample + valid_until\n50 Hz target"]; rx [label="adapter receive lease\n100 ms"]; px4 [label="PX4 setpoint / Hold"]; world->cert->admit->sample->rx->px4; newworld [label="new world\nrecertify?",color=orange]; newworld->cert [style=dashed,label="before expiry, if safe"]; cert->px4 [style=dotted,label="expiry: explicit transfer?",color=orange]; }
