digraph G { rankdir=LR; node [shape=box,style=rounded]; request [label="request generation"]; ack [label="VehicleCommand ACK\naccepted/rejected"]; scheduled [label="ScheduledMode active"]; completion [label="ModeCompleted or cancel\nnot Hold status"]; status [label="fresh VehicleStatus\nAUTO_LOITER + charge?"]; transfer [label="authority transfer\ncontract unresolved",color=orange]; takeover [label="operator/failsafe/deactivation\nseparate outcome"]; request->ack; ack->scheduled; scheduled->completion; request->status; status->transfer [color=orange]; scheduled->takeover; completion->transfer [style=dotted,label="insufficient alone"]; }
