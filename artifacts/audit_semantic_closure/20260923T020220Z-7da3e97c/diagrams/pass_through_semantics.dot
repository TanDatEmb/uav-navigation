digraph G { rankdir=LR; node [shape=box,style=rounded]; measured [label="source-stamped measured route\nsegment/u/arc + route/epoch"]; crossing [label="bounded crossing observation\nphysical fact"]; gate [label="accepted mission gate"]; ready [label="exact successor readiness\nindependent fact"]; active [label="successor activation\nexecution transaction"]; measured->crossing; crossing->gate; ready->gate; gate->active [label="request only; later admission",style=dashed]; }
