Panels:
  - Class: rviz_common/Displays
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: odom
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/TF
      Name: TF
      Show Axes: true
    - Class: rviz_default_plugins/PointCloud2
      Name: Registered points
      Topic:
        Value: /lio/registered_points
      Size (m): 0.03
    - Class: rviz_default_plugins/PointCloud2
      Name: Simulated input
      Topic:
        Value: /lidar/points
      Size (m): 0.03
