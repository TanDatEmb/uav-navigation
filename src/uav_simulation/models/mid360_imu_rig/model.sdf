<?xml version="1.0"?>
<sdf version="1.9">
  <!--
    Kinematic test rig only. The GPU lidar produces Gazebo PointCloudPacked and
    the bridge exposes sensor_msgs/PointCloud2. It must never be archived or
    presented as a real Livox Mid-360 recording.
  -->
  <model name="mid360_imu_rig">
    <pose>0 0 1.2 0 0 0</pose>
    <link name="base_link">
      <inertial>
        <mass>1.0</mass>
        <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.03</izz></inertia>
      </inertial>
      <visual name="body_visual">
        <geometry><box><size>0.45 0.35 0.12</size></box></geometry>
      </visual>
      <collision name="body_collision">
        <geometry><box><size>0.45 0.35 0.12</size></box></geometry>
      </collision>
      <sensor name="imu_sensor" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <topic>/sim/imu/data</topic>
        <frame_id>imu_link</frame_id>
      </sensor>
    </link>
    <link name="lidar_link">
      <pose relative_to="base_link">0 0 0.15 0 0 0</pose>
      <visual name="lidar_visual">
        <geometry><cylinder><radius>0.055</radius><length>0.06</length></cylinder></geometry>
      </visual>
      <sensor name="lidar_sensor" type="gpu_lidar">
        <always_on>true</always_on>
        <update_rate>10</update_rate>
        <topic>/sim/lidar/points</topic>
        <frame_id>lidar_link</frame_id>
        <lidar>
          <scan>
            <horizontal><samples>1024</samples><resolution>1</resolution><min_angle>-3.14159265</min_angle><max_angle>3.14159265</max_angle></horizontal>
            <vertical><samples>32</samples><resolution>1</resolution><min_angle>-0.52</min_angle><max_angle>0.52</max_angle></vertical>
          </scan>
          <range><min>0.2</min><max>70.0</max><resolution>0.02</resolution></range>
        </lidar>
      </sensor>
    </link>
    <joint name="base_to_lidar" type="fixed">
      <parent>base_link</parent><child>lidar_link</child>
    </joint>
    <plugin filename="gz-sim-velocity-control-system" name="gz::sim::systems::VelocityControl">
      <topic>/model/mid360_imu_rig/cmd_vel</topic>
    </plugin>
  </model>
</sdf>
