<?xml version="1.0" encoding="UTF-8"?>
<sdf version="1.11">
  <model name="x500_mid360">
    <include merge="true"><uri>x500</uri></include>
    <include merge="true">
      <uri>model://lidar_mid360</uri>
      <pose>0 0 0.28 0 0 0</pose>
    </include>
    <joint name="mid360_mount_joint" type="fixed">
      <parent>base_link</parent><child>livox_frame</child>
      <pose relative_to="base_link">0 0 0.28 0 0 0</pose>
    </joint>
    <!-- Evaluation-only Gazebo ground truth in ENU/FLU.  The repository ROS
         bridge exposes it only as /sim/ground_truth/odometry for monitor and
         report comparison.  The launcher disables PX4's direct Gazebo
         odometry subscriber (SIM_GZ_EN_ODOM=0), so this plugin must never
         become a source for /fmu/in/vehicle_visual_odometry or LIO. -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <!-- OdometryPublisher defaults to base_footprint.  LIO and PX4 use
           base_link, so publish truth for the same rigid body frame. -->
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </model>
</sdf>
