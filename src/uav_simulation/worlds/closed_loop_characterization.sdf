<?xml version="1.0"?>
<!-- Test-only open flight volume for direct PX4 closed-loop characterization.
     Side texture keeps LiDAR observability without putting geometry in the
     analytic reference corridor.  This remains a test-only, open flight
     volume; the characterization node has no obstacle/mission semantics. -->
<sdf version="1.9">
  <world name="closed_loop_characterization">
    <physics type="ode"><max_step_size>0.004</max_step_size><real_time_factor>0.8</real_time_factor><real_time_update_rate>200</real_time_update_rate></physics>
    <gravity>0 0 -9.8</gravity>
    <scene><grid>true</grid><ambient>0.4 0.4 0.4 1</ambient><background>0.72 0.78 0.85 1</background><shadows>true</shadows></scene>
    <model name="ground_plane"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>300 300</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>300 300</size></plane></geometry><material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual></link></model>
    <model name="characterization_wall_east"><static>true</static><pose>28 0 2.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.25 70 5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.25 70 5</size></box></geometry></visual></link></model>
    <model name="characterization_wall_west"><static>true</static><pose>-28 0 2.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.25 70 5</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.25 70 5</size></box></geometry></visual></link></model>
    <model name="characterization_wall_north"><static>true</static><pose>0 28 2.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>56 0.25 5</size></box></geometry></collision><visual name="visual"><geometry><box><size>56 0.25 5</size></box></geometry></visual></link></model>
    <model name="characterization_wall_south"><static>true</static><pose>0 -28 2.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>56 0.25 5</size></box></geometry></collision><visual name="visual"><geometry><box><size>56 0.25 5</size></box></geometry></visual></link></model>
    <model name="texture_pillar_east_01"><static>true</static><pose>22 -8 2.2 0 0 0.1</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.45</radius><length>4.4</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.45</radius><length>4.4</length></cylinder></geometry></visual></link></model>
    <model name="texture_pillar_east_02"><static>true</static><pose>22 4 2.0 0 0 -0.2</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.35</radius><length>4</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.35</radius><length>4</length></cylinder></geometry></visual></link></model>
    <model name="texture_pillar_east_03"><static>true</static><pose>22 17 2.4 0 0 0.3</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.5</radius><length>4.8</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.5</radius><length>4.8</length></cylinder></geometry></visual></link></model>
    <model name="texture_pillar_west_01"><static>true</static><pose>-22 -2 1.8 0 0 -0.1</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.4</radius><length>3.6</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.4</radius><length>3.6</length></cylinder></geometry></visual></link></model>
    <model name="texture_pillar_west_02"><static>true</static><pose>-22 10 2.3 0 0 0.2</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.55</radius><length>4.6</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.55</radius><length>4.6</length></cylinder></geometry></visual></link></model>
    <model name="texture_pillar_west_03"><static>true</static><pose>-22 22 2.0 0 0 -0.3</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.35</radius><length>4</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.35</radius><length>4</length></cylinder></geometry></visual></link></model>
    <model name="texture_panel_east"><static>true</static><pose>24 11 1.5 0 0 0.35</pose><link name="link"><collision name="collision"><geometry><box><size>0.8 1.8 3</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.8 1.8 3</size></box></geometry></visual></link></model>
    <model name="texture_panel_west"><static>true</static><pose>-24 16 1.7 0 0 -0.4</pose><link name="link"><collision name="collision"><geometry><box><size>1.6 0.7 3.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.6 0.7 3.4</size></box></geometry></visual></link></model>
    <model name="texture_overhead_01"><static>true</static><pose>0 8 6.0 0 0 0.03</pose><link name="link"><collision name="collision"><geometry><box><size>10 3 0.25</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 3 0.25</size></box></geometry></visual></link></model>
    <model name="texture_overhead_02"><static>true</static><pose>0 20 6.0 0 0 -0.04</pose><link name="link"><collision name="collision"><geometry><box><size>10 3 0.25</size></box></geometry></collision><visual name="visual"><geometry><box><size>10 3 0.25</size></box></geometry></visual></link></model>
    <light name="sunUTC" type="directional"><pose>0 0 500 0 0 0</pose><cast_shadows>true</cast_shadows><intensity>1</intensity><direction>0.001 0.625 -0.78</direction></light>
    <spherical_coordinates><surface_model>EARTH_WGS84</surface_model><world_frame_orientation>ENU</world_frame_orientation><latitude_deg>10.8231</latitude_deg><longitude_deg>106.6297</longitude_deg><elevation>10</elevation></spherical_coordinates>
    <include><uri>model://x500_mid360</uri><name>x500_mid360</name><pose>0 0 0.2 0 0 0</pose></include>
  </world>
</sdf>
