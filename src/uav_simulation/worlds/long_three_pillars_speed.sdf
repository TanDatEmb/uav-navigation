    <model name="speed_feature_tree_01"><static>true</static><pose>10.0 -8.0 2.0 0 0 0.1</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.45</radius><length>4.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.45</radius><length>4.0</length></cylinder></geometry></visual></link></model>
