    <model name="long_three_speed_pillar_03"><static>true</static><pose>105.0 0.0 3.25 0 0 -0.14</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>1.20</radius><length>6.50</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>1.20</radius><length>6.50</length></cylinder></geometry><material><ambient>0.75 0.20 0.48 1</ambient><diffuse>0.90 0.25 0.60 1</diffuse></material></visual></link></model>

    <!-- Perception-only geometry stays outside the nominal +/-8 m detour
