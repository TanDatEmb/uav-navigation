    <model name="ground_plane"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>260 60</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>260 60</size></plane></geometry><material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual></link></model>

    <!-- Three genuine route obstacles.  Their 35 m spacing leaves a clear
         acceleration/recovery interval between bypasses. -->
    <model name="long_three_speed_pillar_01"><static>true</static><pose>35.0 0.0 3.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>1.20</radius><length>6.50</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>1.20</radius><length>6.50</length></cylinder></geometry><material><ambient>0.85 0.55 0.08 1</ambient><diffuse>0.95 0.70 0.10 1</diffuse></material></visual></link></model>
