<?xml version="1.0"?>
<sdf version="1.9">
  <world name="long_featured">
    <physics type="ode"><max_step_size>0.004</max_step_size><real_time_factor>0.8</real_time_factor><real_time_update_rate>200</real_time_update_rate></physics>
    <gravity>0 0 -9.8</gravity>
    <scene><grid>true</grid><ambient>0.4 0.4 0.4 1</ambient><background>0.72 0.78 0.85 1</background><shadows>true</shadows></scene>
    <model name="ground_plane"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry><material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual></link></model>
    <!-- Discrete pillar/tree-like obstacles leave a free route at every
         cross-section.  Pillars stay below the z=2.8 to 3.0 m flight level;
         roadside trees and the elevated scaffold supply returns for the
         MID-360 lower ray. -->
    <model name="long_featured_pillar_01"><static>true</static><pose>9.0 -2.80 1.0 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.65</radius><length>2.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.65</radius><length>2.0</length></cylinder></geometry><material><ambient>0.85 0.65 0.10 1</ambient><diffuse>0.95 0.75 0.12 1</diffuse></material></visual></link></model>
    <model name="long_featured_pillar_02"><static>true</static><pose>17.5 2.60 1.10 0 0 0.12</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.75</radius><length>2.2</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.75</radius><length>2.2</length></cylinder></geometry><material><ambient>0.10 0.70 0.55 1</ambient><diffuse>0.12 0.85 0.65 1</diffuse></material></visual></link></model>
    <model name="long_featured_pillar_03"><static>true</static><pose>26.0 -2.60 1.20 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.70</radius><length>2.4</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.70</radius><length>2.4</length></cylinder></geometry><material><ambient>0.80 0.20 0.55 1</ambient><diffuse>0.95 0.25 0.65 1</diffuse></material></visual></link></model>
    <model name="long_featured_pillar_04"><static>true</static><pose>34.5 2.80 0.90 0 0 0.28</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.85</radius><length>1.8</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.85</radius><length>1.8</length></cylinder></geometry><material><ambient>0.85 0.65 0.10 1</ambient><diffuse>0.95 0.75 0.12 1</diffuse></material></visual></link></model>
    <model name="long_featured_pillar_05"><static>true</static><pose>42.5 -2.80 1.10 0 0 0.43</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.70</radius><length>2.2</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.70</radius><length>2.2</length></cylinder></geometry><material><ambient>0.10 0.70 0.55 1</ambient><diffuse>0.12 0.85 0.65 1</diffuse></material></visual></link></model>
    <model name="long_featured_pillar_06"><static>true</static><pose>50.0 2.60 1.00 0 0 0.18</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.75</radius><length>2.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.75</radius><length>2.0</length></cylinder></geometry><material><ambient>0.80 0.20 0.55 1</ambient><diffuse>0.95 0.25 0.65 1</diffuse></material></visual></link></model>
    <!-- Sparse roadside trees/poles at 4 to 5 m offset.  Their vertical sides
         intersect the MID-360 horizontal rays at the flight height, making
         the centre tube observable without closing it with a wall. -->
    <model name="long_featured_tree_01"><static>true</static><pose>6.0 -4.0 1.90 0 0 0.08</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.35</radius><length>3.8</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.35</radius><length>3.8</length></cylinder></geometry></visual></link></model>
    <model name="long_featured_tree_02"><static>true</static><pose>14.0 4.0 1.90 0 0 -0.11</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.45</radius><length>3.8</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.45</radius><length>3.8</length></cylinder></geometry></visual></link></model>
    <model name="long_featured_tree_03"><static>true</static><pose>23.0 -4.5 1.90 0 0 0.19</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.30</radius><length>3.8</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.30</radius><length>3.8</length></cylinder></geometry></visual></link></model>
    <model name="long_featured_tree_04"><static>true</static><pose>32.0 4.5 1.90 0 0 -0.23</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.50</radius><length>3.8</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.50</radius><length>3.8</length></cylinder></geometry></visual></link></model>
    <model name="long_featured_tree_05"><static>true</static><pose>41.0 -4.0 1.90 0 0 0.31</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.40</radius><length>3.8</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.40</radius><length>3.8</length></cylinder></geometry></visual></link></model>
    <model name="long_featured_tree_06"><static>true</static><pose>50.0 4.0 1.90 0 0 -0.37</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.55</radius><length>3.8</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.55</radius><length>3.8</length></cylinder></geometry></visual></link></model>
    <!-- Non-periodic LiDAR texture panels. These are real collision geometry,
         not visual-only materials: varied yaw, width and height create edges
         and independent surface normals while remaining at least 4.8 m from
         the centre-line flight tube. -->
    <model name="long_featured_texture_01"><static>true</static><pose>3.5 5.0 1.50 0 0 0.18</pose><link name="link"><collision name="collision"><geometry><box><size>1.2 0.5 3.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.2 0.5 3.0</size></box></geometry><material><ambient>0.18 0.45 0.82 1</ambient><diffuse>0.22 0.55 0.95 1</diffuse></material></visual></link></model>
    <model name="long_featured_texture_02"><static>true</static><pose>11.0 -5.2 1.70 0 0 -0.32</pose><link name="link"><collision name="collision"><geometry><box><size>0.6 1.2 3.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.6 1.2 3.4</size></box></geometry><material><ambient>0.72 0.28 0.16 1</ambient><diffuse>0.90 0.34 0.20 1</diffuse></material></visual></link></model>
    <model name="long_featured_texture_03"><static>true</static><pose>20.0 5.5 1.25 0 0 0.47</pose><link name="link"><collision name="collision"><geometry><box><size>1.8 0.45 2.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.8 0.45 2.5</size></box></geometry><material><ambient>0.22 0.62 0.30 1</ambient><diffuse>0.28 0.78 0.38 1</diffuse></material></visual></link></model>
    <model name="long_featured_texture_04"><static>true</static><pose>29.0 -5.0 1.80 0 0 -0.61</pose><link name="link"><collision name="collision"><geometry><box><size>0.5 1.5 3.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.5 1.5 3.6</size></box></geometry><material><ambient>0.64 0.24 0.70 1</ambient><diffuse>0.78 0.30 0.86 1</diffuse></material></visual></link></model>
    <model name="long_featured_texture_05"><static>true</static><pose>39.0 5.2 1.45 0 0 0.79</pose><link name="link"><collision name="collision"><geometry><box><size>1.4 0.6 2.9</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.4 0.6 2.9</size></box></geometry><material><ambient>0.16 0.62 0.62 1</ambient><diffuse>0.20 0.78 0.78 1</diffuse></material></visual></link></model>
    <model name="long_featured_texture_06"><static>true</static><pose>47.0 -5.5 1.65 0 0 -0.94</pose><link name="link"><collision name="collision"><geometry><box><size>0.7 1.6 3.3</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.7 1.6 3.3</size></box></geometry><material><ambient>0.78 0.48 0.12 1</ambient><diffuse>0.94 0.58 0.16 1</diffuse></material></visual></link></model>
    <!-- Asymmetric feature scaffold remains outside the flight tube but
         supplies additional vertical/corner normals for LIO. -->
    <model name="long_featured_corner_a"><static>true</static><pose>14.0 6.8 2.75 0 0 0.24</pose><link name="link"><collision name="collision"><geometry><box><size>2.4 0.7 5.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.4 0.7 5.5</size></box></geometry></visual></link></model>
    <model name="long_featured_pole_b"><static>true</static><pose>27.0 -6.2 2.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.32</radius><length>5.5</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.32</radius><length>5.5</length></cylinder></geometry></visual></link></model>
    <model name="long_featured_beam_c"><static>true</static><pose>37.5 6.5 4.65 0.1 0 0.58</pose><link name="link"><collision name="collision"><geometry><box><size>3.6 0.5 0.7</size></box></geometry></collision><visual name="visual"><geometry><box><size>3.6 0.5 0.7</size></box></geometry></visual></link></model>
    <model name="long_featured_low_d"><static>true</static><pose>51.5 -6.8 2.25 0 0 0.37</pose><link name="link"><collision name="collision"><geometry><box><size>1.6 1.0 4.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.6 1.0 4.5</size></box></geometry></visual></link></model>
    <light name="sunUTC" type="directional"><pose>0 0 500 0 0 0</pose><cast_shadows>true</cast_shadows><intensity>1</intensity><direction>0.001 0.625 -0.78</direction></light>
