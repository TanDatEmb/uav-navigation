<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="uav_sensor_frames">
  <!--
    The numeric extrinsics below are explicit PLACEHOLDERS, not calibration.
    Replace them with measured values and record their provenance before using
    real sensor data. The arrangement is the one source of truth for the
    standalone base_link -> livox_frame -> livox_imu_frame tree.
  -->
  <!-- The vehicle mount is required; zero is not a valid fallback. -->
  <xacro:arg name="livox_mount_xyz"/>
  <xacro:arg name="livox_mount_rpy"/>
  <xacro:arg name="livox_lidar_to_imu_xyz" default="0.011 0.02329 -0.04412"/>
  <xacro:arg name="livox_lidar_to_imu_rpy" default="0 0 0"/>

  <!-- base_link origin: UAV reference, intended near the centre of mass. -->
  <link name="base_link"/>
  <!-- Livox LiDAR sensing origin. Raw points reaching the estimator are FLU. -->
  <link name="livox_frame"/>
  <!-- Livox IMU sensing origin. Measurements reaching the estimator are FLU. -->
  <link name="livox_imu_frame"/>

  <joint name="base_link_to_livox_frame" type="fixed">
    <parent link="base_link"/>
    <child link="livox_frame"/>
    <origin xyz="$(arg livox_mount_xyz)" rpy="$(arg livox_mount_rpy)"/>
  </joint>
  <joint name="livox_frame_to_livox_imu_frame" type="fixed">
    <parent link="livox_frame"/>
    <child link="livox_imu_frame"/>
    <origin xyz="$(arg livox_lidar_to_imu_xyz)" rpy="$(arg livox_lidar_to_imu_rpy)"/>
  </joint>
</robot>
