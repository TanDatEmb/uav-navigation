<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>navigation_planning_backend</name>
  <version>0.1.0</version>
  <description>Pinned planning backend with product-owned world-model adapters.</description>
  <maintainer email="maintainers@example.invalid">UAV Navigation maintainers</maintainer>
  <license>LGPL-3.0-or-later</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <depend>eigen</depend>
  <depend>fmt</depend>
  <depend>navigation_world_model</depend>
  <depend>rog_map_vendor</depend>
  <depend>std_msgs</depend>
  <depend>yaml-cpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
