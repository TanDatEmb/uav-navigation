<?xml version="1.0"?>
<package format="3">
  <name>navigation_runtime</name>
  <version>0.1.0</version>
  <description>Single ROS composition boundary for navigation mapping and planning.</description>
  <maintainer email="maintainers@example.invalid">UAV Navigation maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <depend>builtin_interfaces</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>navigation_interfaces</depend>
  <depend>navigation_mapping</depend>
  <depend>navigation_planning</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
