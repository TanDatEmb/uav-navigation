<?xml version="1.0"?>
<package format="3">
  <name>navigation_mapping</name>
  <version>0.1.0</version>
  <description>
    Product-owned synchronous navigation world-model core. The ROS runtime
    composition boundary lives in navigation_runtime.
  </description>
  <maintainer email="maintainers@example.invalid">UAV Navigation maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>builtin_interfaces</depend>
  <depend>rog_map_vendor</depend>
  <depend>libpcl-all-dev</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
