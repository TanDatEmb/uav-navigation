<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uavnav_px4_bridge</name>
  <version>0.1.0</version>
  <description>PX4 bridge core for uav-navigation: FLU to FRD frame conversion, the external-vision (EV) encoder and SITL PX4 time conversion. ROS-free library; the node is added separately.</description>
  <maintainer email="maintainers@example.invalid">UAV Navigation maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>uavnav_core</depend>
  <depend>eigen3_cmake_module</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
