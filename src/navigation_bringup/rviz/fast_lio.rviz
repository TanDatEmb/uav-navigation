Panels:
  - Class: rviz_common/Displays
    Name: Displays

  - Class: rviz_common/Selection
    Name: Selection

  - Class: rviz_common/Tool Properties
    Name: Tool Properties

Visualization Manager:
  Class: ""

  Displays:
    - Alpha: 0.5
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>

    - Class: rviz_default_plugins/TF
      Enabled: true
      Frame Timeout: 15
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true

    - Alpha: 0.95
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: FlatColor
      Color: 255; 190; 40
      Decay Time: 0
      Enabled: true
      Name: ROG-Map / Occupied (occ)
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.20
      Style: Boxes
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /navigation_mapping/visualization/occupied
      Use Fixed Frame: true

    - Alpha: 0.30
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: FlatColor
      Color: 255; 60; 40
      Decay Time: 0
      Enabled: true
      Name: ROG-Map / Inflated Occupied (inf_occ)
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.20
      Style: Boxes
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /navigation_mapping/visualization/inflated_occupied
      Use Fixed Frame: true

    - Alpha: 0.10
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: FlatColor
      Color: 160; 160; 160
      Decay Time: 0
      Enabled: true
      Name: ROG-Map / Unknown (unk)
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.20
      Style: Boxes
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /navigation_mapping/visualization/unknown
      Use Fixed Frame: true

    - Alpha: 1.0
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: FlatColor
      Color: 50; 220; 220
      Decay Time: 0
      Enabled: true
      Name: ROG-Map / Frontier
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: false
      Size (Pixels): 4
      Size (m): 0.20
      Style: Boxes
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /navigation_mapping/visualization/frontier
      Use Fixed Frame: true

    - Class: rviz_default_plugins/Path
      Color: 50; 255; 80
      Enabled: true
      Head Diameter: 0.3
      Head Length: 0.3
      Line Style: Lines
      Line Width: 0.08
      Name: Navigation / Planned Trajectory
      Offset:
        X: 0
        Y: 0
        Z: 0
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /navigation/visualization/planned_path
      Use Timestamp: false

    - Angle Tolerance: 0.01
      Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 1000
      Name: Corrected LIO Odometry
      Position Tolerance: 0.01
      Shape:
        Axes Length: 0.5
        Axes Radius: 0.05
        Color: 255; 25; 0
        Head Length: 0.3
        Head Radius: 0.1
        Shaft Length: 1
        Shaft Radius: 0.05
        Value: Axes
      Topic:
        Depth: 20
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lio/odometry_corrected

  Enabled: true

  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: lio_odom
    Frame Rate: 30

  Name: root

  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure

  Views:
    Current:
      Class: rviz_default_plugins/ThirdPersonFollower
      Distance: 10
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Name: Current View
      Pitch: 0.55
      Target Frame: base_link
      Yaw: 3.14159

Window Geometry:
  Height: 900
  Width: 1440
