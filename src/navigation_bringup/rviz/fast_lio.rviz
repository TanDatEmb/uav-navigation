Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Selection
    Name: Selection
  - Class: rviz_common/Tool Properties
    Name: Tool Properties
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.25
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 120; 124; 130
      Enabled: true
      Name: Grid
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: <Fixed Frame>
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Marker Scale: 0.5
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: false
      Name: Local Map (RGB axis)
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.02
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lio/local_map
      Use Fixed Frame: true
      Axis: Z
      Min Value: -3
      Max Value: 8
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: FlatColor
      Color: 166; 181; 194
      Decay Time: 0
      Enabled: false
      Name: ROG / Measured Obstacles
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: false
      Size (Pixels): 4
      Size (m): 0.30
      Style: Boxes
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /rog_map/occupied_voxels
      Use Fixed Frame: true
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: FlatColor
      Color: 217; 139; 55
      Decay Time: 0
      Enabled: false
      Name: ROG / Keep-out Surface
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.30
      Style: Boxes
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /rog_map/inflation_surface
      Use Fixed Frame: true
    - Alpha: 0.15
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: FlatColor
      Color: 217; 139; 55
      Decay Time: 0
      Enabled: false
      Name: ROG / Full Inflated Volume (Debug)
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.30
      Style: Boxes
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /rog_map/inflated_voxels
      Use Fixed Frame: true
    - Class: rviz_default_plugins/Marker
      Enabled: false
      Name: ROG / Local Bounds
      Namespaces: {}
      Queue Size: 10
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rog_map/local_bounds
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: ROG / Semantic Map
      Namespaces: {}
      Queue Size: 1
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rog_map/semantic_map
    - Alpha: 1
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: false
      Name: Registered Points (RGB axis)
      Position Transformer: XYZ
      Queue Size: 1
      Selectable: false
      Size (Pixels): 3
      Size (m): 0.03
      Style: Points
      Topic:
        Depth: 5
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /lio/registered_points
      Use Fixed Frame: true
      Axis: Z
      Min Value: -3
      Max Value: 8
    - Angle Tolerance: 0.01
      Class: rviz_default_plugins/Odometry
      Enabled: true
      Keep: 1
      Name: Corrected LIO Odometry
      Position Tolerance: 0.01
      Shape:
        Axes Length: 0.35
        Axes Radius: 0.02
        Color: 180; 180; 180
        Head Length: 0.3
        Head Radius: 0.1
        Shaft Length: 1
        Shaft Radius: 0.02
        Value: Axes
      Topic:
        Depth: 20
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /lio/odometry_corrected
  Enabled: true
  Global Options:
    Background Color: 34; 39; 46
    Fixed Frame: lio_odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 18
      Focal Point:
        X: 0
        Y: 0
        Z: 1
      Name: Current View
      Pitch: 0.55
      Target Frame: lio_odom
      Yaw: 0.8
Window Geometry:
  Height: 900
  Width: 1440
