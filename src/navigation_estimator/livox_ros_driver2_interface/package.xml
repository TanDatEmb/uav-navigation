<?xml version="1.0"?>
<package format="3">
  <name>livox_ros_driver2</name>
  <version>1.2.6</version>
  <description>
    Interface-only pinned packaging of official livox_ros_driver2 CustomMsg
    definitions. This package does not contain the Livox SDK2 device driver.
  </description>
  <maintainer email="maintainers@example.invalid">UAV Navigation maintainers</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>std_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
