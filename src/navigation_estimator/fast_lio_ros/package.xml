<?xml version="1.0"?>
<package format="3">
  <name>fast_lio_ros</name>
  <version>0.1.0</version>
  <description>Thin ROS 2 boundary for the UAV navigation LiDAR-IMU estimator.</description>
  <maintainer email="maintainers@example.invalid">UAV Navigation maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>fast_lio_core</depend>
  <depend>diagnostic_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>livox_ros_driver2</depend>
  <depend>nav_msgs</depend>
  <depend>openssl</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
