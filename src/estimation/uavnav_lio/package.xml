<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd"
  schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uavnav_lio</name>
  <version>0.1.0</version>
  <description>The lio process of uav-navigation: the ROS-free ingest layer over LioRunner (node mount config, bounded wait for IMU coverage, /lio/state decimation and base_link mapping, refused overlapping calls) and the lio ROS node (message conversion, one callback group, recorder, ordered shutdown).</description>
  <maintainer email="maintainers@example.invalid">UAV Navigation maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>uavnav_core</depend>
  <depend>uavnav_lio_core</depend>
  <depend>eigen3_cmake_module</depend>
  <depend>builtin_interfaces</depend>
  <depend>geometry_msgs</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>uavnav_interfaces</depend>
  <depend>uavnav_ros</depend>
  <test_depend>ament_cmake_gtest</test_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
