    <model name="open_speed_near_04"><static>true</static><pose>58 6.4 1.8 0 0 -0.25</pose><link name="link"><collision name="collision"><geometry><box><size>1.0 1.2 3.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.0 1.2 3.6</size></box></geometry></visual></link></model>
    <model name="open_speed_overhead_01"><static>true</static><pose>24 0 8.0 0 0 0.03</pose><link name="link"><collision name="collision"><geometry><box><size>7 4 0.3</size></box></geometry></collision><visual name="visual"><geometry><box><size>7 4 0.3</size></box></geometry></visual></link></model>
    <model name="open_speed_overhead_02"><static>true</static><pose>72 1 8.2 0 0 0.05</pose><link name="link"><collision name="collision"><geometry><box><size>7 3.5 0.3</size></box></geometry></collision><visual name="visual"><geometry><box><size>7 3.5 0.3</size></box></geometry></visual></link></model>
    <model name="open_speed_overhead_03"><static>true</static><pose>120 -1 7.8 0 0 -0.06</pose><link name="link"><collision name="collision"><geometry><box><size>6 4 0.3</size></box></geometry></collision><visual name="visual"><geometry><box><size>6 4 0.3</size></box></geometry></visual></link></model>
