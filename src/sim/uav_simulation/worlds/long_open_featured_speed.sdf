    <model name="open_speed_texture_05"><static>true</static><pose>72 -9.0 2.2 0 0 0.60</pose><link name="link"><collision name="collision"><geometry><box><size>1.5 0.6 4.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.5 0.6 4.4</size></box></geometry></visual></link></model>
    <model name="open_speed_texture_06"><static>true</static><pose>88 9.0 1.5 0 0 -0.70</pose><link name="link"><collision name="collision"><geometry><box><size>0.7 1.2 3.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.7 1.2 3.0</size></box></geometry></visual></link></model>
    <model name="open_speed_texture_07"><static>true</static><pose>104 -9.0 1.9 0 0 0.80</pose><link name="link"><collision name="collision"><geometry><box><size>1.8 0.5 3.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.8 0.5 3.8</size></box></geometry></visual></link></model>
    <model name="open_speed_texture_08"><static>true</static><pose>120 9.0 1.3 0 0 -0.90</pose><link name="link"><collision name="collision"><geometry><box><size>0.9 1.5 2.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.9 1.5 2.6</size></box></geometry></visual></link></model>
    <!-- Irregular corner landmarks improve scan-matching parallax on the
         140 m leg without creating a continuous wall or a route obstacle. -->
    <model name="open_speed_corner_02"><static>true</static><pose>14 -10.0 2.5 0 0 0.20</pose><link name="link"><collision name="collision"><geometry><box><size>2.0 1.0 5.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.0 1.0 5.0</size></box></geometry></visual></link></model>
    <model name="open_speed_corner_03"><static>true</static><pose>47 10.0 2.0 0 0 -0.35</pose><link name="link"><collision name="collision"><geometry><box><size>1.4 1.2 4.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.4 1.2 4.0</size></box></geometry></visual></link></model>
    <model name="open_speed_corner_04"><static>true</static><pose>83 -10.0 2.8 0 0 0.55</pose><link name="link"><collision name="collision"><geometry><box><size>2.6 0.8 5.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.6 0.8 5.6</size></box></geometry></visual></link></model>
    <model name="open_speed_corner_05"><static>true</static><pose>117 10.0 1.8 0 0 -0.75</pose><link name="link"><collision name="collision"><geometry><box><size>1.8 1.4 3.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.8 1.4 3.6</size></box></geometry></visual></link></model>
    <!-- Four asymmetric landmarks break the long periodic side-feature
         pattern and provide persistent parallax for FAST-LIO.  Their closest
         route-facing edges remain outside |y|=9.4 m, so they cannot become a
         hidden route obstacle in the open-speed calibration. -->
    <model name="open_speed_landmark_01"><static>true</static><pose>31 -10.5 3.0 0 0 0.35</pose><link name="link"><collision name="collision"><geometry><box><size>2.0 0.7 4.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.0 0.7 4.8</size></box></geometry></visual></link></model>
    <model name="open_speed_landmark_02"><static>true</static><pose>63 10.8 2.6 0 0 -0.80</pose><link name="link"><collision name="collision"><geometry><box><size>1.0 1.6 5.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.0 1.6 5.2</size></box></geometry></visual></link></model>
    <model name="open_speed_landmark_03"><static>true</static><pose>97 -11.4 3.6 0 0 1.10</pose><link name="link"><collision name="collision"><geometry><box><size>2.8 0.8 6.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.8 0.8 6.2</size></box></geometry></visual></link></model>
    <model name="open_speed_landmark_04"><static>true</static><pose>128 10.1 2.2 0 0 -0.30</pose><link name="link"><collision name="collision"><geometry><box><size>1.4 2.2 4.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.4 2.2 4.4</size></box></geometry></visual></link></model>
    <!-- Near-corridor 3D features are deliberately offset from the center
         line by at least 5.5 m. They provide vertical/lateral parallax for
         the FAST-LIO ablation without forming a wall or route obstacle. -->
    <model name="open_speed_near_01"><static>true</static><pose>12 -6.5 2.5 0 0 0.20</pose><link name="link"><collision name="collision"><geometry><box><size>1.4 0.8 5.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.4 0.8 5.0</size></box></geometry></visual></link></model>
    <model name="open_speed_near_02"><static>true</static><pose>27 6.2 2.2 0 0 -0.55</pose><link name="link"><collision name="collision"><geometry><box><size>0.8 1.0 4.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.8 1.0 4.4</size></box></geometry></visual></link></model>
