    <model name="open_speed_tree_06"><static>true</static><pose>120 10 2 0 0 -0.6</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.6</radius><length>4</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.6</radius><length>4</length></cylinder></geometry></visual></link></model>
    <model name="open_speed_panel_01"><static>true</static><pose>18 11 1.6 0 0 0.2</pose><link name="link"><collision name="collision"><geometry><box><size>1.8 0.6 3.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.8 0.6 3.2</size></box></geometry></visual></link></model>
