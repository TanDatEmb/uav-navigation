    <model name="open_speed_post_12"><static>true</static><pose>136 8.5 2.1 0 0 0.7</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.4</radius><length>4.2</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.4</radius><length>4.2</length></cylinder></geometry></visual></link></model>
    <!-- Staggered edge panels add non-repeating corners and vertical edges
         without forming parallel walls or entering the +/-8 m route band. -->
    <model name="open_speed_texture_01"><static>true</static><pose>8 -9.0 1.7 0 0 0.15</pose><link name="link"><collision name="collision"><geometry><box><size>1.2 0.5 3.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.2 0.5 3.4</size></box></geometry></visual></link></model>
    <model name="open_speed_texture_02"><static>true</static><pose>24 9.0 2.0 0 0 -0.30</pose><link name="link"><collision name="collision"><geometry><box><size>0.6 1.4 4.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.6 1.4 4.0</size></box></geometry></visual></link></model>
    <model name="open_speed_texture_03"><static>true</static><pose>40 -9.0 1.4 0 0 0.40</pose><link name="link"><collision name="collision"><geometry><box><size>2.0 0.4 2.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.0 0.4 2.8</size></box></geometry></visual></link></model>
