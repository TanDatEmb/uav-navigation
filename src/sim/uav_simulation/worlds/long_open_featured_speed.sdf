    <model name="open_speed_post_08"><static>true</static><pose>88 8.5 2.1 0 0 0.5</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.4</radius><length>4.2</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.4</radius><length>4.2</length></cylinder></geometry></visual></link></model>
    <model name="open_speed_post_09"><static>true</static><pose>100 -8.5 2.3 0 0 -0.5</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.35</radius><length>4.6</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.35</radius><length>4.6</length></cylinder></geometry></visual></link></model>
