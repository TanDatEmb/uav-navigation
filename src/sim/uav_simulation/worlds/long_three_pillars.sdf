<?xml version="1.0"?>
<sdf version="1.9">
  <world name="long_three_pillars">
    <physics type="ode"><max_step_size>0.004</max_step_size><real_time_factor>0.8</real_time_factor><real_time_update_rate>200</real_time_update_rate></physics>
    <gravity>0 0 -9.8</gravity>
    <scene><grid>true</grid><ambient>0.4 0.4 0.4 1</ambient><background>0.72 0.78 0.85 1</background><shadows>true</shadows></scene>
    <model name="ground_plane"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry><material><ambient>0.75 0.75 0.75 1</ambient><diffuse>0.75 0.75 0.75 1</diffuse></material></visual></link></model>
    <!-- Exactly three route obstacles; their alternating offsets force fresh
         local detours while leaving a free corridor around each column. -->
    <model name="long_three_pillar_01"><static>true</static><pose>12.0 0.0 2.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>1.05</radius><length>5.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>1.05</radius><length>5.0</length></cylinder></geometry><material><ambient>0.85 0.55 0.08 1</ambient><diffuse>0.95 0.70 0.10 1</diffuse></material></visual></link></model>
    <model name="long_three_pillar_02"><static>true</static><pose>24.0 1.8 2.5 0 0 0.12</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>1.05</radius><length>5.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>1.05</radius><length>5.0</length></cylinder></geometry><material><ambient>0.10 0.65 0.50 1</ambient><diffuse>0.12 0.82 0.62 1</diffuse></material></visual></link></model>
    <model name="long_three_pillar_03"><static>true</static><pose>36.0 -1.8 2.5 0 0 -0.12</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>1.05</radius><length>5.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>1.05</radius><length>5.0</length></cylinder></geometry><material><ambient>0.75 0.20 0.48 1</ambient><diffuse>0.90 0.25 0.60 1</diffuse></material></visual></link></model>
    <!-- Non-route texture/feature objects keep the estimator observable over
         the long leg.  They are at least 4 m off the nominal centre line and
         are not counted as the three route columns. -->
    <model name="texture_tree_01"><static>true</static><pose>5.0 -4.5 1.9 0 0 0.1</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.40</radius><length>3.8</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.40</radius><length>3.8</length></cylinder></geometry></visual></link></model>
    <model name="texture_tree_02"><static>true</static><pose>13.0 4.5 1.8 0 0 -0.2</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.45</radius><length>3.6</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.45</radius><length>3.6</length></cylinder></geometry></visual></link></model>
    <model name="texture_tree_03"><static>true</static><pose>21.0 -4.5 2.0 0 0 0.3</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.35</radius><length>4.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.35</radius><length>4.0</length></cylinder></geometry></visual></link></model>
    <model name="texture_tree_04"><static>true</static><pose>29.0 4.5 1.7 0 0 -0.4</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.50</radius><length>3.4</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.50</radius><length>3.4</length></cylinder></geometry></visual></link></model>
    <model name="texture_tree_05"><static>true</static><pose>37.0 -4.5 1.9 0 0 0.5</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.40</radius><length>3.8</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.40</radius><length>3.8</length></cylinder></geometry></visual></link></model>
    <model name="texture_tree_06"><static>true</static><pose>45.0 7.0 1.8 0 0 -0.6</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.55</radius><length>3.6</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.55</radius><length>3.6</length></cylinder></geometry></visual></link></model>
    <model name="texture_panel_01"><static>true</static><pose>8.0 5.3 1.5 0 0 0.2</pose><link name="link"><collision name="collision"><geometry><box><size>1.4 0.5 3.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.4 0.5 3.0</size></box></geometry></visual></link></model>
    <model name="texture_panel_02"><static>true</static><pose>16.0 -5.3 1.6 0 0 -0.3</pose><link name="link"><collision name="collision"><geometry><box><size>0.6 1.5 3.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.6 1.5 3.2</size></box></geometry></visual></link></model>
    <!-- Keep this texture outside the north-side detour corridor around
         route pillar 02; it remains visible clutter without becoming an
         unintended fourth route obstacle. -->
    <model name="texture_panel_03"><static>true</static><pose>25.0 7.5 1.3 0 0 0.5</pose><link name="link"><collision name="collision"><geometry><box><size>1.8 0.5 2.6</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.8 0.5 2.6</size></box></geometry></visual></link></model>
    <model name="texture_panel_04"><static>true</static><pose>33.0 -5.4 1.7 0 0 -0.6</pose><link name="link"><collision name="collision"><geometry><box><size>0.5 1.6 3.4</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.5 1.6 3.4</size></box></geometry></visual></link></model>
    <model name="texture_panel_05"><static>true</static><pose>42.0 7.0 1.4 0 0 0.7</pose><link name="link"><collision name="collision"><geometry><box><size>1.5 0.6 2.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.5 0.6 2.8</size></box></geometry></visual></link></model>
    <model name="texture_panel_06"><static>true</static><pose>49.0 -5.2 1.6 0 0 -0.8</pose><link name="link"><collision name="collision"><geometry><box><size>0.7 1.4 3.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.7 1.4 3.2</size></box></geometry></visual></link></model>
    <model name="feature_corner_a"><static>true</static><pose>14.0 7.0 2.6 0 0 0.25</pose><link name="link"><collision name="collision"><geometry><box><size>2.4 0.7 5.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.4 0.7 5.2</size></box></geometry></visual></link></model>
    <model name="feature_corner_b"><static>true</static><pose>30.0 -7.0 2.6 0 0 -0.35</pose><link name="link"><collision name="collision"><geometry><box><size>2.2 0.7 5.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>2.2 0.7 5.2</size></box></geometry></visual></link></model>
    <model name="feature_beam"><static>true</static><pose>40.0 6.8 4.5 0.1 0 0.45</pose><link name="link"><collision name="collision"><geometry><box><size>3.6 0.5 0.7</size></box></geometry></collision><visual name="visual"><geometry><box><size>3.6 0.5 0.7</size></box></geometry></visual></link></model>
    <!-- Sparse overhead texture strips add a stable upward-facing plane for
         3-D lidar registration without turning the route into a tunnel. -->
    <model name="texture_overhead_01"><static>true</static><pose>8.0 0.0 6.0 0 0 0.03</pose><link name="link"><collision name="collision"><geometry><box><size>8.0 4.0 0.30</size></box></geometry></collision><visual name="visual"><geometry><box><size>8.0 4.0 0.30</size></box></geometry></visual></link></model>
    <model name="texture_overhead_02"><static>true</static><pose>24.0 0.0 6.0 0 0 -0.04</pose><link name="link"><collision name="collision"><geometry><box><size>8.0 4.0 0.30</size></box></geometry></collision><visual name="visual"><geometry><box><size>8.0 4.0 0.30</size></box></geometry></visual></link></model>
    <model name="texture_overhead_03"><static>true</static><pose>40.0 0.0 6.0 0 0 0.05</pose><link name="link"><collision name="collision"><geometry><box><size>8.0 4.0 0.30</size></box></geometry></collision><visual name="visual"><geometry><box><size>8.0 4.0 0.30</size></box></geometry></visual></link></model>
    <light name="sunUTC" type="directional"><pose>0 0 500 0 0 0</pose><cast_shadows>true</cast_shadows><intensity>1</intensity><direction>0.001 0.625 -0.78</direction></light>
    <spherical_coordinates><surface_model>EARTH_WGS84</surface_model><world_frame_orientation>ENU</world_frame_orientation><latitude_deg>10.8231</latitude_deg><longitude_deg>106.6297</longitude_deg><elevation>10</elevation></spherical_coordinates>
    <include><uri>model://x500_mid360</uri><name>x500_mid360</name><pose>0 0 0.2 0 0 0</pose></include>
  </world>
</sdf>
