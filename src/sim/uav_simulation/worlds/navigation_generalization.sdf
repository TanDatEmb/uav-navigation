<?xml version="1.0"?>
<sdf version="1.9">
  <world name="navigation_generalization">
    <physics type="ode"><max_step_size>0.004</max_step_size><real_time_factor>0.8</real_time_factor><real_time_update_rate>200</real_time_update_rate></physics>
    <gravity>0 0 -9.8</gravity>
    <scene><grid>true</grid><ambient>0.4 0.4 0.4 1</ambient><background>0.72 0.78 0.85 1</background><shadows>true</shadows></scene>
    <model name="ground_plane"><static>true</static><link name="link"><collision name="collision"><geometry><plane><normal>0 0 1</normal><size>180 140</size></plane></geometry></collision><visual name="visual"><geometry><plane><normal>0 0 1</normal><size>180 140</size></plane></geometry><material><ambient>0.72 0.72 0.72 1</ambient><diffuse>0.72 0.72 0.72 1</diffuse></material></visual></link></model>

    <!-- +X long-open approach followed by mixed small and transverse obstacles. -->
    <model name="gen_sudden_pillar"><static>true</static><pose>72 0 3.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>1.2</radius><length>6.5</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>1.2</radius><length>6.5</length></cylinder></geometry></visual></link></model>
    <model name="gen_small_post"><static>true</static><pose>55 0.4 2.0 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.28</radius><length>4.0</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.28</radius><length>4.0</length></cylinder></geometry></visual></link></model>
    <model name="gen_cross_wall_x"><static>true</static><pose>90 0 2.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1.0 7.0 5.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.0 7.0 5.0</size></box></geometry></visual></link></model>
    <model name="gen_long_wall_x"><static>true</static><pose>35 6 2.0 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>20.0 0.8 4.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>20.0 0.8 4.0</size></box></geometry></visual></link></model>

    <!-- +Y leg: both obstacle orientations and a locally narrow 4 m gap. -->
    <model name="gen_cross_wall_y"><static>true</static><pose>105 25 2.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>7.0 1.0 5.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>7.0 1.0 5.0</size></box></geometry></visual></link></model>
    <model name="gen_long_wall_y"><static>true</static><pose>111 44 2.0 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.8 18.0 4.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.8 18.0 4.0</size></box></geometry></visual></link></model>
    <model name="gen_gap_west"><static>true</static><pose>97 65 2.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>12.0 1.2 5.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>12.0 1.2 5.5</size></box></geometry></visual></link></model>
    <model name="gen_gap_east"><static>true</static><pose>113 65 2.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>12.0 1.2 5.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>12.0 1.2 5.5</size></box></geometry></visual></link></model>

    <!-- -X leg: asymmetric small obstacles expose axis and side-selection bias. -->
    <model name="gen_small_post_west"><static>true</static><pose>78 90.2 1.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.25</radius><length>3.5</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.25</radius><length>3.5</length></cylinder></geometry></visual></link></model>
    <model name="gen_small_box_west"><static>true</static><pose>58 89.7 1.5 0 0 0.35</pose><link name="link"><collision name="collision"><geometry><box><size>0.7 0.7 3.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.7 0.7 3.0</size></box></geometry></visual></link></model>

    <!-- Lane-change and hairpin/U-turn area. -->
    <model name="gen_lane_divider"><static>true</static><pose>25 81 1.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>16.0 0.6 3.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>16.0 0.6 3.0</size></box></geometry></visual></link></model>
    <model name="gen_uturn_island"><static>true</static><pose>25 50 2.25 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>2.0</radius><length>4.5</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>2.0</radius><length>4.5</length></cylinder></geometry></visual></link></model>

    <!-- Sparse landmarks are outside the nominal route but keep long X/Y legs observable. -->
    <model name="gen_landmark_sw"><static>true</static><pose>15 -8 2.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>2 1 5</size></box></geometry></collision><visual name="visual"><geometry><box><size>2 1 5</size></box></geometry></visual></link></model>
    <model name="gen_landmark_se"><static>true</static><pose>105 -8 2.0 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.5</radius><length>4</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.5</radius><length>4</length></cylinder></geometry></visual></link></model>
    <model name="gen_landmark_ne"><static>true</static><pose>116 92 2.5 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1 2 5</size></box></geometry></collision><visual name="visual"><geometry><box><size>1 2 5</size></box></geometry></visual></link></model>
    <model name="gen_landmark_nw"><static>true</static><pose>15 100 2.0 0 0 0</pose><link name="link"><collision name="collision"><geometry><cylinder><radius>0.55</radius><length>4</length></cylinder></geometry></collision><visual name="visual"><geometry><cylinder><radius>0.55</radius><length>4</length></cylinder></geometry></visual></link></model>
    <model name="gen_landmark_mid"><static>true</static><pose>4 55 2.5 0 0 0.3</pose><link name="link"><collision name="collision"><geometry><box><size>1.2 3.0 5.0</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.2 3.0 5.0</size></box></geometry></visual></link></model>

    <light name="sunUTC" type="directional"><pose>0 0 500 0 0 0</pose><cast_shadows>true</cast_shadows><intensity>1</intensity><direction>0.001 0.625 -0.78</direction></light>
    <spherical_coordinates><surface_model>EARTH_WGS84</surface_model><world_frame_orientation>ENU</world_frame_orientation><latitude_deg>10.8231</latitude_deg><longitude_deg>106.6297</longitude_deg><elevation>10</elevation></spherical_coordinates>
    <include><uri>model://x500_mid360</uri><name>x500_mid360</name><pose>0 0 0.2 0 0 0</pose></include>
  </world>
</sdf>
