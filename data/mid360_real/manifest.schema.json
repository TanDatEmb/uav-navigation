{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "UAV Navigation real Mid-360 capture manifest",
  "type": "object",
  "required": ["schema_version", "dataset_id", "source", "not_synthetic", "topics", "files"],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "not_synthetic": {"const": true},
    "source": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["physical_capture", "official_download"]},
        "canonical_url": {"type": "string"},
        "driver_version": {"type": "string"},
        "operator": {"type": "string"},
        "license": {"type": "string"}
      }
    },
    "topics": {
      "type": "array",
      "minItems": 4,
      "items": {"type": "object", "required": ["name", "type"]}
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "bytes", "sha256"],
        "properties": {
          "path": {"type": "string"},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
